@prefix ex: <http://example.com/FriendGraph#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:LikesAuthorShape a sh:NodeShape;
  sh:property [
      sh:minCount 1;
      sh:path ex:authorOf
    ].

ex:PersonShape a sh:NodeShape;
  sh:property [
      sh:path ex:likes;
      sh:qualifiedValueShape ex:LikesAuthorShape
    ], [
      sh:maxCount 5;
      sh:path ex:likes
    ], [
      sh:path ex:likes;
      sh:qualifiedValueShape [ a sh:NodeShape;
          sh:class ex:Recipe
        ]
    ];
  sh:targetClass ex:Person.
