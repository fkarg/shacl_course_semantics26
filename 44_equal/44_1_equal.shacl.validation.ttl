@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:EmailValidationShape a sh:NodeShape;
  sh:property [
    sh:path sh:equals ;
    sh:maxCount 0 ;
    sh:message "The value of ex:hasEmail must be disjoint with the value of ex:address. Remove the equals statement" 
  ],[
    sh:path sh:disjoint;
    sh:minCount 1;
    sh:maxCount 1;
    sh:message "The value of ex:hasEmail must be disjoint with the value of ex:address. Add a disjoint statement"
  ] ;
  sh:targetNode ex:EmailShape .