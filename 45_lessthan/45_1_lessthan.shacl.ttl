@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:BookReleaseShape a sh:PropertyShape;
  sh:lessThanOrEquals ex:firstReleased;
  sh:path ex:latestRelease;
  sh:targetSubjectsOf ex:latestRelease.
