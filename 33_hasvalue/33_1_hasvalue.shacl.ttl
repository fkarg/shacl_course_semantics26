@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:LikeShape a sh:PropertyShape;
  sh:hasValue ex:pizza;
  sh:message "Not liking pizza is not possible!";
  sh:path ex:likes;
  sh:targetClass ex:Person.
