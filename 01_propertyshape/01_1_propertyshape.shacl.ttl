@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:RecipeCommentShape a sh:PropertyShape;
  sh:minCount 1;
  sh:path rdfs:comment;
  sh:targetClass ex:Recipe.

ex:RecipeLabelShape a sh:PropertyShape.
