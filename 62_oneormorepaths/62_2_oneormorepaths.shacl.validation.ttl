@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:AdventureBookValidationShape a sh:PropertyShape;
  sh:hasValue rdfs:subClassOf;
  sh:minCount 1;
  sh:path (sh:path sh:oneOrMorePath);
  sh:targetNode ex:AdventureBookShape.

ex:IsbnValidationShape a sh:NodeShape;
  sh:property [
      sh:hasValue rdfs:subPropertyOf;
      sh:message "Add the one or more path syntax to evaluate the isbn";
      sh:minCount 1;
      sh:path (sh:path sh:oneOrMorePath)
    ], [
      sh:maxInclusive 1;
      sh:minCount 1;
      sh:minInclusive 1;
      sh:path sh:minCount
    ];
  sh:targetNode ex:IsbnShape.
