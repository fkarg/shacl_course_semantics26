@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:identifierShape a sh:PropertyShape;
  sh:message "The identifier must have a label!";
  sh:minCount 1;
  sh:path rdfs:label;
  sh:targetNode ex:identifier.
