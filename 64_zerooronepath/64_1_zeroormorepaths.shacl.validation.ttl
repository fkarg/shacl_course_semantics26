@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:IngredientsValidationShape a sh:PropertyShape;
  sh:message "Change the validation to zero or one path.";
  sh:minCount 1;
  sh:path (sh:path rdf:rest rdf:first sh:zeroOrMorePath);
  sh:targetNode ex:IngredientsShape.
