@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

ex:PersonValidationShape a sh:PropertyShape;
  sh:hasValue ex:isIn;
  sh:message "Add the sequence path syntax to evaluate the country";
  sh:path (sh:property sh:path rdf:rest rdf:first);
  sh:targetNode ex:PersonShape.
