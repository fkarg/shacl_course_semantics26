@prefix ex: <http://example.com/FriendGraph#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

ex:ContactGroup a sh:PropertyGroup;
  rdfs:label "Contact Information";
  sh:order 1.

ex:PersonGroup a sh:PropertyGroup;
  rdfs:label "Personal Information";
  sh:order 0.

ex:PersonShape a sh:NodeShape;
  sh:property [
      sh:datatype xsd:string;
      sh:description "The email address of the contact";
      sh:group ex:ContactGroup;
      sh:maxCount 1;
      sh:message "The email address is not valid";
      sh:minCount 1;
      sh:name "Email";
      sh:path ex:hasEmail;
      sh:pattern "[W-z.0-9]+@[A-z.0-9]+\\.\\w{2,3}"
    ], [
      sh:description "The kind of accomendation where a person lives.";
      sh:group ex:ContactGroup;
      sh:in (ex:Apartment ex:House);
      sh:maxCount 1;
      sh:message "It must be ex:Apartment or ex:House";
      sh:minCount 1;
      sh:name "Accomendation Type";
      sh:path rdf:type
    ], [
      sh:description "The phone number with international prefix (e.g., +49)";
      sh:group ex:ContactGroup;
      sh:message "A valid telephone number must start with +[0-9] for the country code.";
      sh:name "Telephone";
      sh:path ex:phone;
      sh:regex "[+][0-9]{1,3}-[0-9]{1,20}"
    ], [
      sh:datatype xsd:integer;
      sh:description "The age of the person";
      sh:group ex:PersonGroup;
      sh:maxCount 1;
      sh:maxInclusive 120;
      sh:minCount 1;
      sh:minInclusive 1;
      sh:name "Age";
      sh:path ex:age
    ], [
      sh:description "A comment about the person";
      sh:group ex:PersonGroup;
      sh:maxCount 1;
      sh:maxLength 120;
      sh:name "Comment";
      sh:path rdfs:comment
    ], [
      sh:datatype xsd:string;
      sh:description "The address of the contact";
      sh:group ex:ContactGroup;
      sh:maxCount 1;
      sh:message "The address is not valid";
      sh:minCount 1;
      sh:name "Address";
      sh:path (sh:contact ex:address)
    ];
  sh:targetClass ex:Person.
